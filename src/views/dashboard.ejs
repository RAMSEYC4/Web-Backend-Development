<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Welcome back, <%= name %>!</p>

    <h2>Your Account</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>
    <p>Role: <%= role %></p>

    <% if (role === "admin") { %>
        <h2>Administration</h2>
        <p><a href="/users">View all registered users</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
