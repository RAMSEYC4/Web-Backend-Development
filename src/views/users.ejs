<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <p>All registered users:</p>
        <table class="user-list">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                    <tr>
                        <td><%= user.name %></td>
                        <td><%= user.email %></td>
                        <td><%= user.role_name %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </main>

<%- include('partials/footer') %>
