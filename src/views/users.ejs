<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>All users registered on the site:</p>

    <table class="user-list">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email (Username)</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach((user) => { %>
                <tr>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.role_name %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <p><a href="/dashboard">Back to dashboard</a></p>
</main>

<%- include('partials/footer') %>
